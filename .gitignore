# files and file types to ignore
*.pyc
*.pyd
*.so
*~

# ignore the build directories
*.egg-info/
.eggs/
build/
__pycache__/
dist/
cache/
td/
**/cache/
**/td/
__pycache__/
*.nbc
*.nbi
*.pyd
.vscode/
*/__pycache__/*
tests/throughput/results/*.png
.venv/*
*.sif
llm_docs
llm_context

# ignore common venv folders
.venv*
.*venv
.env*
.*env

# macOS
.DS_Store
.claude/

